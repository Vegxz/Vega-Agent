# build outputs
.build-release/
.build-tests/
.build-offline/
build/
.gradle/
local.properties
*.apk
*.aab

# generated by tools/find-kotlinc.sh (a borrowed Kotlin compiler)
tools/.kotlinc/
tools/gen/

# Signing material — NEVER commit a private key.
#
# No exceptions, and there used to be one: the release key was shipped inside the
# tree so an update could always be signed. That is fine for handing a build to one
# person and wrong the moment the tree becomes a public repository, because anyone
# holding the key can publish an update that users' phones accept as genuine.
#
# The key now lives outside the repository. See keystore/README-KEYSTORE.md for how
# to point a build at it.
*.jks
*.keystore
*.p12
*.pepk
keystore/keystore.properties
local.keystore.properties

sdk/

# python bytecode from the test gate
__pycache__/
*.pyc
