# Keep the scripts and sources in LF so a checkout on Windows still builds.

*.sh        text eol=lf
gradlew      text eol=lf
*.kts       text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.properties text eol=lf
*.gradle    text eol=lf

# Binary payloads — never touch their bytes.
*.apk  binary
*.aab  binary
*.jks  binary
*.keystore binary
*.p12  binary
*.pepk binary
*.jar  binary
*.ttf  binary
*.png  binary
*.mp3  binary
